# ==============================================================================
# WeatherGPT — Native Production & Development Configuration Template
# ==============================================================================
# Copy this file to `.env` and configure appropriate values for your environment.
# NEVER commit a real `.env` file containing actual secrets or passwords.
# ==============================================================================

# --- 1. Application Runtime Settings ---
# Environment profile: 'development', 'staging', 'production', or 'test'
APP_ENV=development
APP_NAME=WeatherGPT
API_VERSION=v1
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# In production, SECRET_KEY must be a cryptographically strong random string.
# The application will refuse to boot in production if left as the default.
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# CORS Origins: Comma-separated list or JSON array of allowed origins.
# In production, explicit origins must be listed (wildcard '*' is disallowed).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request Timeout: Maximum allowed processing time for an HTTP request in seconds.
REQUEST_TIMEOUT_SECONDS=30.0

# Interactive API Documentation: Enable or disable /docs and /redoc.
DOCS_ENABLED=true

# Proxy Headers: Enable when running behind a trusted reverse proxy (e.g. Nginx).
PROXY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=127.0.0.1

# --- 2. PostgreSQL + PostGIS Database Settings ---
# PostgreSQL 16+ with PostGIS 3.4+ extension connection URL.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weathergpt
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10.0
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
DATABASE_URL_SCHEME=postgresql+asyncpg

# --- 3. LLM Provider Settings (Laptop 1 Inference Host or Hosted API) ---
LLM_PROVIDER_TYPE=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
LLM_API_KEY=not_required_for_local_vllm
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0

# --- 4. Meteorological Adapters & Data Ingestion ---
# IMD / Sachet CAP Warning Feed
IMD_BASE_URL=https://mausam.imd.gov.in
IMD_CAP_URL=https://sachet.ndma.gov.in/cap_feed
IMD_API_KEY=
IMD_TIMEOUT_SECONDS=10.0

# NOAA GFS 0.25° NWP Data
GFS_BASE_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod
GFS_DATA_PATH=

# Open-Meteo Operational Forecast
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Commercial & Open Weather Providers (API keys configured via env vars)
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=

WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_API_KEY=

TOMORROW_BASE_URL=https://api.tomorrow.io/v4
TOMORROW_API_KEY=

# Air Quality Provider (OpenAQ)
OPENAQ_BASE_URL=https://api.openaq.org/v2
OPENAQ_API_KEY=

WEATHER_PROVIDER_TIMEOUT_SECONDS=10.0
WEATHER_PROVIDER_RETRIES=2

# --- 5. Cache & Optional Services ---
REDIS_URL=redis://localhost:6379/0
